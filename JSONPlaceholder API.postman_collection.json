  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.expect(pm.response.to.be.ok);\r",
                  "    //pm.expect(pm.response.code).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has correct user id\", function () {\r",
                  "    const body = pm.response.json();\r",
                  "    const userId = parseInt(pm.environment.get(\"userId\"))\r",
                  "    pm.expect(body.id).to.eql(userId);\r",
                  "})\r",
                  "\r",
                  "pm.test(\"User has a name\", function () {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body.name).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User address has a city\", function () {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body.address).to.have.property(\"city\");\r",
                  "    pm.expect(body.address.city).to.be.a(\"string\");\r",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Create Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Created post has title\", function () {\r",
              "    const body = pm.response.json();\r",
              "    const title = JSON.parse(pm.request.body).title;\r",
              "    \r",
              "    pm.expect(body).to.have.property(\"title\");\r",
              "    pm.expect(body.title).to.eql(title);\r",
              "})\r",
              "\r",
              "const body = pm.response.json();\r",
              "pm.collectionVariables.set(\"newPostId\", body.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.variables.set(\"timestamp\", Date.now());\r",
              "pm.variables.set(\"requestId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Request-Id",
            "value": "{{requestId}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"title\": \"Post created at {{timestamp}}\",\r\n    \"body\": \"Hello from Postman {{$randomInt}}\",\r\n    \"userId\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Post",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/:id",
          "protocol": "https",
          "host": [
