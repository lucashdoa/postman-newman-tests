          ],
          "variable": [
            {
              "key": "id",
              "value": "{{newPostId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?_limit={{pageSize}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "_limit",
              "value": "{{pageSize}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Posts by User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.expect(pm.response.code).to.eql(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is a non-empty array\", function () {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body).to.be.an(\"array\").that.is.not.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Each post has a title\", function () {\r",
              "    const body = pm.response.json();\r",
              "    body.forEach(function (post) {\r",
              "        pm.expect(post).to.have.property(\"title\");\r",
              "        pm.expect(post.title).to.be.a(\"string\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is under 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type is present\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\")\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?userId={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
